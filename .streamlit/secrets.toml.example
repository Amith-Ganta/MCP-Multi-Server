# Copy this file to `.streamlit/secrets.toml` for local runs, OR paste the same
# keys into the "Secrets" box of your Streamlit Community Cloud app settings.
# Do NOT commit the real secrets.toml — it is in .gitignore.

# Required: your OpenAI API key.
OPENAI_API_KEY = "sk-proj-..."

# Optional: override the default model (gpt-4o).
OPENAI_MODEL = "gpt-4o"

# The expense server is local (SQLite, databases.db) and needs no token.
